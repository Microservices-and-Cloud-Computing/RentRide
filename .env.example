# ==============================================================================
# RentRide Cloud Platform - Environment Configuration Template
# Duplicate this file as .env in the project root to override cluster variables.
# ==============================================================================

# ── PostgreSQL Multi-Database Credentials ────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432
POSTGRES_MULTIPLE_DATABASES=rentride_user_db,rentride_vehicle_db,rentride_booking_db,rentride_payment_db,rentride_notification_db

# ── RabbitMQ Broker Settings ──────────────────────────────────────────────────
RABBITMQ_DEFAULT_USER=guest
RABBITMQ_DEFAULT_PASS=guest
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

# ── MailHog SMTP & Web UI ────────────────────────────────────────────────────
MAILHOG_SMTP_PORT=1025
MAILHOG_UI_PORT=8025

# ── Eureka Service Registry ──────────────────────────────────────────────────
EUREKA_SERVER_PORT=8761
EUREKA_CLIENT_SERVICE_URL_DEFAULTZONE=http://service-registry:8761/eureka/

# ── API Gateway & Edge Security ──────────────────────────────────────────────
GATEWAY_PORT=8080
JWT_SECRET_KEY=NGRmYmE1ZjQ4M2E4ZjI4ZjM2YTkzMjQ5OTM2NWNlMWQ3OGFmOWY4ZDgyZGMzNzRmOWI0OTFhZmQ=
JWT_EXPIRATION_MS=86400000

# ── Service Port Mappings ────────────────────────────────────────────────────
USER_SERVICE_PORT=8081
VEHICLE_SERVICE_PORT=8082
BOOKING_SERVICE_PORT=8083
PAYMENT_SERVICE_PORT=8084
NOTIFICATION_SERVICE_PORT=8085

# ── JVM Memory Configuration ─────────────────────────────────────────────────
JAVA_OPTS=-XX:+UseContainerSupport -XX:MaxRAMPercentage=75.0

