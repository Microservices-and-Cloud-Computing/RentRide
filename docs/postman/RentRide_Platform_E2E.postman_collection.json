    {
      "name": "03 - Reservation Workflow & Date Overlap Prevention",
      "item": [
        {
          "name": "3.1 Check Vehicle Availability",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Vehicle availability returned 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "var json = pm.response.json();",
                  "pm.test('Vehicle is available', function () {",
                  "    pm.expect(json.available).to.be.true;",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{customer_token}}"
              }
            ],
            "url": "{{gateway_url}}/api/v1/vehicles/{{vehicle_id}}/availability"
          }
        },
        {
          "name": "3.2 Customer Creates Booking",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Booking created with 201 Created', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "var json = pm.response.json();",
                  "pm.test('Booking status is PENDING_PAYMENT', function () {",
                  "    pm.expect(json.status).to.eql('PENDING_PAYMENT');",
                  "});",
                  "if (json.id) { pm.environment.set('booking_id', json.id); }",
                  "if (json.bookingReference) { pm.environment.set('booking_reference', json.bookingReference); }",
                  "if (json.totalCost) { pm.environment.set('total_cost', json.totalCost.toString()); }"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
