          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Customer Registration status code is 201 Created or 200 OK', function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([200, 201]);",
                  "});",
                  "var json = pm.response.json();",
                  "pm.test('Customer role is confirmed', function () {",
                  "    pm.expect(json.role).to.eql('CUSTOMER');",
                  "});",
                  "if (json.id) { pm.environment.set('customer_id', json.id); }"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"Alex Mercer\",\n  \"email\": \"alex.mercer@rentride.com\",\n  \"password\": \"Password123!\",\n  \"phoneNumber\": \"+94771234567\",\n  \"driverLicenseNumber\": \"B1234567\"\n}"
