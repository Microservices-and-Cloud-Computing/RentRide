      "name": "05 - Event-Driven Notification Check",
      "item": [
        {
          "name": "5.1 Verify MailHog Captured Confirmation Email",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('MailHog messages endpoint returns 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
