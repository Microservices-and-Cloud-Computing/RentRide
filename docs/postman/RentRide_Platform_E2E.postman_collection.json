                  "    var firstMail = json.items[0];",
                  "    pm.expect(firstMail.Content.Headers.Subject[0]).to.include('Booking Confirmation');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{mailhog_url}}/api/v2/messages"
          }
        }
      ]
