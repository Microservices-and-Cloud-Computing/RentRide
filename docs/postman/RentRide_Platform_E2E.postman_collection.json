    {
      "name": "04 - Online Payment & OpenFeign Callback",
      "item": [
        {
          "name": "4.1 Customer Checkout Payment - Approved Card",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Payment checkout succeeded with 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "var json = pm.response.json();",
                  "pm.test('Payment status is COMPLETED', function () {",
                  "    pm.expect(json.status).to.eql('COMPLETED');",
                  "});",
                  "if (json.transactionReference) { pm.environment.set('transaction_ref', json.transactionReference); }"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{customer_token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"bookingId\": {{booking_id}},\n  \"amount\": {{total_cost}},\n  \"currency\": \"LKR\",\n  \"paymentMethod\": \"CREDIT_CARD\",\n  \"cardNumber\": \"4111111111114242\",\n  \"cardHolderName\": \"Alex Mercer\",\n  \"expiryMonth\": 12,\n  \"expiryYear\": 2028,\n  \"cvv\": \"123\"\n}"
            },
            "url": "{{gateway_url}}/api/v1/payments/checkout"
          }
        },
        {
          "name": "4.2 Verify Payment Transaction",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Transaction verification returned 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "var json = pm.response.json();",
                  "pm.test('Transaction is verified and COMPLETED', function () {",
                  "    pm.expect(json.status).to.eql('COMPLETED');",
                  "    pm.expect(json.isVerified).to.be.true;",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{gateway_url}}/api/v1/payments/verify/{{transaction_ref}}"
          }
        },
        {
          "name": "4.3 Verify Booking Transitioned to CONFIRMED via OpenFeign",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Booking lookup returns 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "var json = pm.response.json();",
                  "pm.test('Booking status transitioned to CONFIRMED via OpenFeign', function () {",
                  "    pm.expect(json.status).to.eql('CONFIRMED');",
                  "    pm.expect(json.paymentStatus).to.eql('PAID');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{customer_token}}"
              }
            ],
            "url": "{{gateway_url}}/api/v1/bookings/{{booking_id}}"
          }
        },
        {
          "name": "4.4 Process Payment - Declined Card Test",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Declined card checkout handled cleanly', function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([200, 400, 402]);",
                  "    if (pm.response.code === 200) {",
                  "        var json = pm.response.json();",
                  "        pm.expect(json.status).to.eql('FAILED');",
                  "    }",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{customer_token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"bookingId\": {{booking_id}},\n  \"amount\": {{booking_id}}0.0,\n  \"currency\": \"LKR\",\n  \"paymentMethod\": \"CREDIT_CARD\",\n  \"cardNumber\": \"41111111111{{booking_id}}0\",\n  \"cardHolderName\": \"Alex Mercer\",\n  \"expiryMonth\": 12,\n  \"expiryYear\": 2028,\n  \"cvv\": \"000\"\n}"
            },
            "url": "{{gateway_url}}/api/v1/payments/checkout"
          }
        }
      ]
