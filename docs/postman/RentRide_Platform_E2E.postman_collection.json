            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"vehicleId\": {{vehicle_id}},\n  \"startDate\": \"2026-11-06\",\n  \"endDate\": \"2026-11-09\",\n  \"pickupLocation\": \"Colombo Central Station\"\n}"
            },
            "url": "{{gateway_url}}/api/v1/bookings"
          }
