              "protocol": "http",
              "host": ["localhost"],
              "port": "8082",
              "path": ["api", "v1", "vehicles"]
            }
          }
        },
        {
          "name": "3.3 Manufacturing Year Before 2000 (400 Bad Request)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 400 Bad Request\", function () {",
                  "    pm.response.to.have.status(400);",
                  "});",
                  "",
                  "pm.test(\"Validation error specifies manufacturingYear requirement\", function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.status).to.eql(400);",
