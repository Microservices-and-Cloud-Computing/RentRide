    {
      "name": "3. Input Validation & Error Handling",
      "item": [
        {
          "name": "3.1 Invalid License Plate Format (400 Bad Request)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 400 Bad Request\", function () {",
                  "    pm.response.to.have.status(400);",
                  "});",
                  "",
                  "pm.test(\"Clean error response with licensePlateNumber validation message\", function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.status).to.eql(400);",
                  "    pm.expect(json.error).to.eql(\"Validation Failed\");",
                  "    pm.expect(json.errors.licensePlateNumber).to.include(\"Sri Lankan vehicle registration plate format\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-User-Id", "value": "1" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"make\": \"Toyota\",\n  \"model\": \"Prius\",\n  \"manufacturingYear\": 2021,\n  \"licensePlateNumber\": \"INVALID-FORMAT\",\n  \"categoryId\": 1,\n  \"seatingCapacity\": 5,\n  \"fuelType\": \"HYBRID\",\n  \"transmission\": \"AUTOMATIC\",\n  \"dailyRentalRate\": 8500.00,\n  \"location\": \"Colombo\"\n}"
            },
            "url": {
              "raw": "http://localhost:8082/api/v1/vehicles",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8082",
              "path": ["api", "v1", "vehicles"]
            }
          }
        },
        {
