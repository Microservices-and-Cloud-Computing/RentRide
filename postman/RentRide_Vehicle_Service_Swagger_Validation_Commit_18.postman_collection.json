{
  "info": {
    "_postman_id": "c1800000-vehicle-openapi-validation-rentride",
    "name": "RentRide - Vehicle Service OpenAPI & Validation (Commit 18)",
    "description": "Comprehensive Postman test collection for Commit 18: OpenAPI 3 / Swagger UI specification, Category endpoints, and Bean Validation error responses.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. OpenAPI 3 / Swagger UI Documentation",
      "item": [
        {
          "name": "1.1 Get OpenAPI 3 JSON Specification",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Verify OpenAPI 3 info attributes\", function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.openapi).to.match(/^3\\./);",
                  "    pm.expect(json.info.title).to.eql(\"RentRide Vehicle & Inventory Service API\");",
                  "    pm.expect(json.info.version).to.eql(\"1.0.0\");",
                  "    pm.expect(json.paths[\"/api/v1/vehicles\"]).to.not.be.undefined;",
                  "    pm.expect(json.paths[\"/api/v1/categories\"]).to.not.be.undefined;",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" }
            ],
            "url": {
              "raw": "http://localhost:8082/v3/api-docs",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8082",
              "path": ["v3", "api-docs"]
            }
          }
        },
        {
          "name": "1.2 Swagger UI Redirect (swagger-ui.html)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 OK or 3xx Redirect\", function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([200, 301, 302, 307, 308]);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "http://localhost:8082/swagger-ui.html",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8082",
              "path": ["swagger-ui.html"]
            }
          }
        },
        {
          "name": "1.3 Swagger UI Index Page",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"HTML content returned for Swagger UI\", function () {",
                  "    pm.expect(pm.response.text()).to.include(\"swagger-ui\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "http://localhost:8082/swagger-ui/index.html",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8082",
              "path": ["swagger-ui", "index.html"]
            }
          }
        }
      ]
    },
    {
      "name": "2. Category Management",
      "item": [
        {
          "name": "2.1 List All Vehicle Categories",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Baseline seeded categories returned\", function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.length).to.be.at.least(1);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "http://localhost:8082/api/v1/categories",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8082",
              "path": ["api", "v1", "categories"]
            }
          }
        },
        {
          "name": "2.2 Get Category by ID",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Category attributes present\", function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.id).to.eql(1);",
                  "    pm.expect(json.name).to.not.be.empty;",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "http://localhost:8082/api/v1/categories/1",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8082",
              "path": ["api", "v1", "categories", "1"]
            }
          }
        },
        {
          "name": "2.3 Create New Category",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 201 Created or 409 Conflict\", function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([201, 409]);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"LUXURY_PREMIUM\",\n  \"description\": \"Executive luxury fleet with chauffeured comfort\",\n  \"baseDailyRate\": 18000.00\n}"
            },
            "url": {
              "raw": "http://localhost:8082/api/v1/categories",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8082",
              "path": ["api", "v1", "categories"]
            }
          }
        }
