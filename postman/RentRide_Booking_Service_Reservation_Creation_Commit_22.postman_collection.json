    {
      "name": "2. Scenario 01: Reservation Creation (Happy Paths)",
      "item": [
        {
          "name": "2.1 Create Multi-Day Reservation (3 Days @ 10,000 = 30,000 LKR)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 201 Created\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "var jsonData = pm.response.json();",
                  "",
                  "pm.test(\"Status is PENDING_PAYMENT\", function () {",
                  "    pm.expect(jsonData.status).to.eql(\"PENDING_PAYMENT\");",
                  "});",
                  "",
                  "pm.test(\"Reference code follows RR-BK- format\", function () {",
                  "    pm.expect(jsonData.bookingReference).to.match(/^RR-BK-\\d{8}-[A-Z0-9]{6}$/);",
                  "});",
                  "",
                  "pm.test(\"Accurate 3 days duration and 30,000 cost calculation\", function () {",
                  "    pm.expect(jsonData.totalDays).to.eql(3);",
                  "    pm.expect(jsonData.dailyRate).to.eql(10000.00);",
                  "    pm.expect(jsonData.totalCost).to.eql(30000.00);",
                  "});",
                  "",
                  "pm.test(\"Vehicle specifications mapped correctly via Feign\", function () {",
                  "    pm.expect(jsonData.vehicleDetails).to.be.an(\"object\");",
                  "    pm.expect(jsonData.vehicleDetails.make).to.eql(\"Toyota\");",
                  "    pm.expect(jsonData.vehicleDetails.model).to.eql(\"Aqua\");",
                  "    pm.expect(jsonData.vehicleDetails.licensePlateNumber).to.eql(\"WP-CBA-1234\");",
                  "});",
                  "",
                  "if (jsonData.id) {",
                  "    pm.collectionVariables.set(\"booking_id\", jsonData.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-User-Id",
                "value": "{{customer_id}}"
              },
              {
                "key": "X-User-Role",
                "value": "ROLE_CUSTOMER"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"vehicleId\": 1,\n  \"startDate\": \"2026-11-01\",\n  \"endDate\": \"2026-11-04\",\n  \"pickupNotes\": \"Arriving around 10:00 AM at Bandaranaike Airport\"\n}"
            },
            "url": {
              "raw": "{{booking_service_url}}/api/v1/bookings",
              "host": [
                "{{booking_service_url}}"
              ],
              "path": [
                "api",
                "v1",
                "bookings"
              ]
            },
            "description": "Creates a 3-day reservation from 2026-11-01 to 2026-11-04. Automatically locks vehicle to RENTED in vehicle-service."
          },
          "response": []
        },
        {
          "name": "2.2 Verify Vehicle 1 is Automatically Locked to RENTED on vehicle-service",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Vehicle is locked: status is RENTED and isAvailable is false\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.status).to.eql(\"RENTED\");",
                  "    pm.expect(jsonData.isAvailable).to.eql(false);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{vehicle_service_url}}/api/v1/vehicles/{{vehicle_id}}/availability",
              "host": [
                "{{vehicle_service_url}}"
              ],
              "path": [
                "api",
                "v1",
                "vehicles",
                "{{vehicle_id}}",
                "availability"
              ]
            },
            "description": "Verifies that booking creation triggered an OpenFeign RPC call to lock the vehicle to RENTED."
          },
          "response": []
        }
