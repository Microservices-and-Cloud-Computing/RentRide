		"name": "RentRide - Vehicle Status & Availability (Commit 17)",
		"description": "Comprehensive Postman test collection for testing Commit 17 internal vehicle status transition endpoints, concurrency conflict handling (HTTP 409), and lightweight availability queries.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
