    {
      "name": "02 - Reservation Creation & Date Conflict Logic",
      "item": [
        {
          "name": "2.1 Create Reservation - Success (PENDING_PAYMENT)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "pm.test('Status code is 201 Created', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "pm.test('Booking created with PENDING_PAYMENT state and valid reference', function () {",
                  "    pm.expect(jsonData.status).to.eql('PENDING_PAYMENT');",
                  "    pm.expect(jsonData.bookingReference).to.match(/^RR-BK-[0-9]{8}-[A-Z0-9]+$/);",
                  "    pm.expect(jsonData.totalDays).to.eql(3);",
                  "    pm.expect(Number(jsonData.totalCost)).to.eql(30000.00);",
                  "});",
                  "if (jsonData.id) {",
                  "    pm.collectionVariables.set('bookingId', jsonData.id.toString());",
                  "    pm.collectionVariables.set('bookingReference', jsonData.bookingReference);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{customerToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"vehicleId\": {{vehicleId}},\n  \"startDate\": \"2026-12-10\",\n  \"endDate\": \"2026-12-13\",\n  \"pickupNotes\": \"Airport arrival rental pickup\"\n}"
            },
            "url": {
              "raw": "{{gatewayUrl}}/api/v1/bookings",
              "host": [
                "{{gatewayUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "bookings"
              ]
            }
          }
        },
        {
          "name": "2.2 Attempt Overlapping Booking (Date Conflict - 409 Conflict)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "pm.test('Status code is 409 Conflict', function () {",
                  "    pm.response.to.have.status(409);",
                  "});",
                  "pm.test('Error message identifies date overlap', function () {",
                  "    pm.expect(jsonData.message).to.include('already has an active reservation overlapping');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
