                  "});",
                  "if (jsonData.accessToken) {",
                  "    pm.collectionVariables.set('providerToken', jsonData.accessToken);",
                  "}",
                  "if (jsonData.user && jsonData.user.id) {",
                  "    pm.collectionVariables.set('providerId', jsonData.user.id.toString());",
                  "}"
