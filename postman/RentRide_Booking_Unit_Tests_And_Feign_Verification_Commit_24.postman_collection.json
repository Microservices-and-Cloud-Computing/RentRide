  "item": [
    {
      "name": "01 - Authentication & Initial Checks",
      "item": [
        {
          "name": "1.1 Login as Customer",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "pm.test('Customer login successful - HTTP 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "    pm.expect(jsonData.accessToken).to.not.be.empty;",
                  "});",
                  "if (jsonData.accessToken) {",
                  "    pm.collectionVariables.set('customerToken', jsonData.accessToken);",
                  "}",
                  "if (jsonData.user && jsonData.user.id) {",
                  "    pm.collectionVariables.set('customerId', jsonData.user.id.toString());",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"kasun@rentride.com\",\n  \"password\": \"Password123!\"\n}"
            },
            "url": {
              "raw": "{{userServiceUrl}}/api/v1/auth/login",
              "host": [
                "{{userServiceUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "login"
              ]
            }
          }
        },
        {
          "name": "1.2 Login as Provider (Vehicle Fleet Owner)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
