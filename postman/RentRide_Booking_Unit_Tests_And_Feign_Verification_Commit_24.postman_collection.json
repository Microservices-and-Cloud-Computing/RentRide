                  "});",
                  "pm.test('Status is COMPLETED and downstream vehicle AVAILABLE', function () {",
                  "    pm.expect(jsonData.status).to.eql('COMPLETED');",
                  "    pm.expect(jsonData.actualReturnDate).to.not.be.null;",
                  "    pm.expect(jsonData.vehicleStatusSummary).to.eql('AVAILABLE');",
                  "    pm.expect(jsonData.endOdometer).to.eql(45550.0);",
                  "    pm.expect(jsonData.finalAmountPaid).to.eql(30000.00);",
                  "});"
                ],
                "type": "text/javascript"
