          "name": "4.1 Process Vehicle Return (GOOD Condition -> Sets AVAILABLE)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "pm.test('Status code is 200 OK', function () {",
