          "name": "1.3 Verify Vehicle Initial Availability (AVAILABLE)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "pm.test('Vehicle availability lookup - HTTP 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "    pm.expect(jsonData.vehicleId).to.eql(Number(pm.collectionVariables.get('vehicleId')));",
                  "    pm.expect(jsonData.isAvailable).to.eql(true);",
                  "    pm.expect(jsonData.status).to.eql('AVAILABLE');",
                  "});"
