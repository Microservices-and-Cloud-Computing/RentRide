        "description": "Tests public verification through API Gateway without requiring an Authorization header (validating RouterValidator whitelist)."
      },
      "response": []
    },
    {
      "name": "6. Query Payment by Booking ID",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200 OK\", function () {",
