    {
      "name": "9. Idempotency Guard - Duplicate Payment Attempt (409 Conflict)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 409 Conflict\", function () {",
              "    pm.response.to.have.status(409);",
              "});",
              "",
              "var jsonData = pm.response.json();",
              "",
              "pm.test(\"Conflict error message verified\", function () {",
              "    pm.expect(jsonData.status).to.eql(409);",
              "    pm.expect(jsonData.error).to.eql(\"Conflict\");",
              "    pm.expect(jsonData.message).to.eql(\"Booking has already been paid and confirmed\");",
              "    pm.expect(jsonData.path).to.eql(\"/api/v1/payments/checkout\");",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-User-Id",
            "value": "{{customerId}}"
