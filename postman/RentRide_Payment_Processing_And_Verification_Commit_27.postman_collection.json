    {
      "name": "7. Checkout - Declined Card (Card ending in 0000)",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "var dynamicBookingId = Math.floor(Math.random() * 900000) + 200000;",
              "pm.collectionVariables.set(\"bookingIdDeclined\", dynamicBookingId.toString());"
            ],
            "type": "text/javascript"
          }
        },
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200 OK (Handled Business Rejection)\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "var jsonData = pm.response.json();",
              "",
              "pm.test(\"Payment Status is FAILED\", function () {",
              "    pm.expect(jsonData.status).to.eql(\"FAILED\");",
              "});",
              "",
              "pm.test(\"Failure reason is 'Insufficient funds'\", function () {",
              "    pm.expect(jsonData.failureReason).to.eql(\"Insufficient funds\");",
              "});",
              "",
              "pm.test(\"Gateway Transaction ID and Receipt are null\", function () {",
              "    pm.expect(jsonData.gatewayTransactionId).to.be.null;",
              "    pm.expect(jsonData.receiptUrl).to.be.null;",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-User-Id",
            "value": "{{customerId}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"bookingId\": {{bookingIdDeclined}},\n  \"amount\": 15000.00,\n  \"currency\": \"LKR\",\n  \"paymentMethod\": \"CREDIT_CARD\",\n  \"cardNumber\": \"4111111111110000\",\n  \"expiryMonth\": 10,\n  \"expiryYear\": 2027,\n  \"cvv\": \"999\"\n}"
        },
        "url": {
          "raw": "{{paymentServiceUrl}}/api/v1/payments/checkout",
