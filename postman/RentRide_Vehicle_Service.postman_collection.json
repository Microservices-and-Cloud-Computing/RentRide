                     "event":  [
                                   {
                                       "listen":  "test",
                                       "script":  {
                                                      "exec":  [
                                                                   "pm.test(\"Status code is 409 Conflict\", function () {",
                                                                   "    pm.response.to.have.status(409);",
                                                                   "});",
                                                                   "",
                                                                   "pm.test(\"Verify conflict error message\", function () {",
                                                                   "    var jsonData = pm.response.json();",
                                                                   "    pm.expect(jsonData.status).to.eql(409);",
                                                                   "    pm.expect(jsonData.error).to.eql(\"Conflict\");",
                                                                   "    pm.expect(jsonData.message).to.include(\"Vehicle cannot transition from RENTED to RENTED\");",
                                                                   "});"
