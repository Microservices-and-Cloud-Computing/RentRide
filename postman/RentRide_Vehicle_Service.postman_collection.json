                 {
                     "name":  "5. Eureka Registry Instance Query (Port 8761)",
                     "event":  [
                                   {
                                       "listen":  "test",
                                       "script":  {
                                                      "exec":  [
                                                                   "pm.test(\"Status code is 200 OK\", function () {",
                                                                   "    pm.response.to.have.status(200);",
                                                                   "});",
                                                                   "",
                                                                   "pm.test(\"VEHICLE-SERVICE is registered in Eureka as UP\", function () {",
                                                                   "    var jsonData = pm.response.json();",
                                                                   "    pm.expect(jsonData.application.name).to.eql(\"VEHICLE-SERVICE\");",
                                                                   "    var instance = jsonData.application.instance[0];",
                                                                   "    pm.expect(instance.status).to.eql(\"UP\");",
                                                                   "    pm.expect(instance.port[\"$\"]).to.eql(8082);",
                                                                   "});"
                                                               ],
                                                      "type":  "text/javascript"
                                                  }
                                   }
