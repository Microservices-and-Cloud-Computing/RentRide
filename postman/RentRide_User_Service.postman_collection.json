		{
			"name": "02 - Authentication",
			"item": [
				{
					"name": "05. Login - Success (200 OK)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 200 OK\", function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"pm.test(\"JWT tokens returned and variables captured\", function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData.accessToken).to.be.a('string');",
									"    pm.expect(jsonData.refreshToken).to.be.a('string');",
									"    pm.expect(jsonData.tokenType).to.eql(\"Bearer\");",
									"    pm.expect(jsonData.expiresIn).to.be.a('number');",
									"    pm.expect(jsonData.user.email).to.eql(\"kasun.customer@rentride.com\");",
									"    pm.expect(jsonData.user.role).to.eql(\"ROLE_CUSTOMER\");",
									"",
									"    // Automatically save tokens to collection variables",
									"    pm.collectionVariables.set(\"accessToken\", jsonData.accessToken);",
									"    pm.collectionVariables.set(\"refreshToken\", jsonData.refreshToken);",
									"    console.log(\"Captured accessToken: \" + jsonData.accessToken.substring(0, 20) + \"...\");",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"kasun.customer@rentride.com\",\n  \"password\": \"Password123!\"\n}"
						},
