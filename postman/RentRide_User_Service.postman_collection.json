									"    pm.response.to.have.status(409);",
									"});",
									"",
									"pm.test(\"Returns error payload indicating email in use\", function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData.status).to.eql(409);",
									"    pm.expect(jsonData.error).to.eql(\"Conflict\");",
									"    pm.expect(jsonData.message).to.include(\"already in use\");",
									"});"
