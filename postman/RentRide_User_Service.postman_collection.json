			"item": [
				{
					"name": "01. Register Customer (Success 201)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 201 Created\", function () {",
									"    pm.response.to.have.status(201);",
									"});",
									"",
									"pm.test(\"Response body contains customer profile without password\", function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData.id).to.be.a('number');",
									"    pm.expect(jsonData.email).to.eql(\"kasun.customer@rentride.com\");",
									"    pm.expect(jsonData.fullName).to.eql(\"Kasun Perera\");",
									"    pm.expect(jsonData.role).to.eql(\"ROLE_CUSTOMER\");",
									"    pm.expect(jsonData.status).to.eql(\"ACTIVE\");",
									"    pm.expect(jsonData.driverLicenseNumber).to.eql(\"B1234567\");",
									"    pm.expect(jsonData.password).to.be.undefined;",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"fullName\": \"Kasun Perera\",\n  \"email\": \"kasun.customer@rentride.com\",\n  \"password\": \"Password123!\",\n  \"phoneNumber\": \"+94771234567\",\n  \"driverLicenseNumber\": \"B1234567\"\n}"
						},
