				{
					"name": "08. Refresh Token - Success (200 OK)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 200 OK\", function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"pm.test(\"Fresh access token returned\", function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData.accessToken).to.be.a('string');",
									"    pm.expect(jsonData.refreshToken).to.eql(pm.collectionVariables.get(\"refreshToken\"));",
									"    pm.expect(jsonData.tokenType).to.eql(\"Bearer\");",
									"",
									"    // Update accessToken in collection variables",
									"    pm.collectionVariables.set(\"accessToken\", jsonData.accessToken);",
									"});"
								],
								"type": "text/javascript"
							}
						}
